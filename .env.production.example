# Production environment for saidur-rahman.com. Copy to .env on the server (never commit the real file).
# Generate APP_KEY with: php artisan key:generate --show

APP_NAME="Saidur Rahman"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://saidur-rahman.com
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saidur_rahman
DB_USERNAME=
DB_PASSWORD=

# Sessions are only used by the admin and the contact form. Cookies are marked secure so they never travel over http.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_DRIVER=file
RESPONSE_CACHE_LIFETIME=86400
QUEUE_CONNECTION=database

# Addresses of the reverse proxies in front of PHP (Nginx on this host, and Cloudflare if its ranges reach PHP directly).
TRUSTED_PROXIES=127.0.0.1

# Security headers. Leave on. Set CSP_REPORT_ONLY=true for a while after changing the policy to watch the browser console.
CSP_ENABLED=true
CSP_REPORT_ONLY=false
HSTS_ENABLED=true

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=hello@saidur-rahman.com
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Turnstile for the contact form (create a widget for saidur-rahman.com).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Only read by `php artisan db:seed` the first time. Remove afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Off-site backups (any S3-compatible store). BACKUP_ARCHIVE_PASSWORD encrypts the zip: keep it, and APP_KEY, in a password manager,
# because a restore needs both. Use BACKUP_DISKS=local to try backups on this machine only.
BACKUP_DISKS=backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=
BACKUP_AWS_BUCKET=
BACKUP_AWS_ENDPOINT=
BACKUP_AWS_USE_PATH_STYLE_ENDPOINT=false
